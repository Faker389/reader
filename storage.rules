rules_version = '2';

// Fovea Cloud Storage rules.
//
// Only profile avatars are stored in the cloud. Book files and covers stay on
// the user's device and are never uploaded.
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/avatar.jpg {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png)');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
